{
  "name": "alexey-mozolya-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "cms:typecheck": "tsc -p cms-worker/tsconfig.json",
    "cms:test": "node --test cms-worker/tests/*.test.ts",
    "cms:check": "npm run cms:typecheck && npm run cms:test",
    "check": "npm run build && node scripts/validate-build.mjs && npm run cms:check"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
