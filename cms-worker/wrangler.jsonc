{
  "name": "alexey-portfolio-telegram-cms",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "vars": {
    "GITHUB_DEFAULT_BRANCH": "master",
    "PRODUCTION_URL": "https://mozolyadesign.github.io/alexey-mozolya-portfolio/"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CMS_STATE", "class_name": "CmsStateDurableObject" }
    ]
  },
  "exports": {
    "CmsStateDurableObject": { "type": "durable-object", "storage": "sqlite" }
  }
}
